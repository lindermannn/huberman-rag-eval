# Copiar a .env y completar. El .env real esta en .gitignore y nunca se commitea.

# --- Evaluacion del RAG (src/eval_rag.js) ---

# Embeddings de las consultas y, con RAG_JUDGE=1, los modelos de juez.
OPENAI_API_KEY=sk-...

# Clave service_role DEL PROYECTO SUPABASE DEL BOT.
# match_kb_published_documents_hybrid_v1 esta concedida solo a service_role,
# asi que una clave publishable/anon devuelve 403.
# Ojo: con la clave de otro proyecto el error es 403 TENANT_OR_BRAND_MISMATCH,
# que parece un problema de datos y en realidad es de proyecto.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Opcionales - los valores por defecto ya apuntan a produccion.
# SUPABASE_URL=https://<ref>.supabase.co
# RAG_TENANT_ID=tenant_huberman
# RAG_BRAND_ID=<uuid de la marca>
# RAG_MODE=production        # production | hybrid | vector
# RAG_JUDGE=1                # activa relevancia del contexto y groundedness
# RAG_LIMIT=3                # corre solo las primeras N preguntas (prueba de humo)
# RAG_JUDGE_MODEL=gpt-4.1-mini
# RAG_ANSWER_MODEL=gpt-4.1

# --- Pipeline de traduccion (apendice, opcional) ---

# Traducciones rapidas y de mejor calidad. Sin esto, cae al Google Translate web gratuito.
GEMINI_API_KEY=your-gemini-api-key-here
